# Copy this to .env.local for local dev. On Railway, set these as real
# environment variables in the service's Variables tab instead.

# Port the server listens on. Railway sets this automatically in
# production -- only needed for local dev.
PORT=3100

# The password for /admin. Pick something real before deploying.
ADMIN_PASSWORD=change-me

# Used to sign the admin session cookie. Any long random string.
SESSION_SECRET=change-me-too

# Full public URL of the site once deployed (used for sitemap/canonical
# links). Leave as localhost for local dev.
APP_URL=http://localhost:3100
